{
  "name": "@motemen/scribe-loop",
  "version": "0.1.0",
  "description": "Read AI agent documents on a handwriting device, write on them with a pen, and send the handwriting back",
  "type": "module",
  "bin": {
    "scribe-loop": "bin/scribe-loop.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "README.ja.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motemen/scribe-loop.git"
  },
  "scripts": {
    "start": "node bin/scribe-loop.mjs serve",
    "test": "node --test test/"
  },
  "optionalDependencies": {
    "playwright-core": "^1.65.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
